# Copia este archivo a .env.local y completa solo lo que necesites.
# Nunca subas .env.local al repositorio.

# Proveedor de vuelos: mock | travelpayouts | ignav
# "ignav" queda pendiente de credenciales; usa mock o travelpayouts.
FLIGHT_PROVIDER=mock

# Horas de cache para resultados de proveedores reales. 0 desactiva la cache.
FLIGHT_CACHE_TTL_HOURS=6
# Horas maximas para servir cache antigua si el proveedor falla.
FLIGHT_CACHE_STALE_HOURS=24
# Backend de cache: sqlite (por defecto) | memory.
FLIGHT_CACHE_BACKEND=sqlite
# Ruta opcional del archivo SQLite. Por defecto .data/flight-cache.sqlite.
# FLIGHT_CACHE_PATH=

# Limite local de peticiones por minuto y timeout por peticion.
TRAVELPAYOUTS_RATE_LIMIT_PER_MINUTE=30
FLIGHT_PROVIDER_TIMEOUT_MS=10000

# Fase 2: token de Travelpayouts (solo servidor).
TRAVELPAYOUTS_TOKEN=

# Fase 2: clave de la API de Ignav (solo servidor).
IGNAV_API_KEY=

# Fase 3: Supabase. Las variables NEXT_PUBLIC_* llegan al navegador.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Fase 3: solo servidor. Nunca usar en componentes cliente.
SUPABASE_SERVICE_ROLE_KEY=

# Fase 4: alertas por Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# Fase 4: secreto compartido con GitHub Actions para ejecutar el job.
CRON_SECRET=

# Fase 4 opcional: email de alertas con Resend.
RESEND_API_KEY=

# URL publica de la app (local en desarrollo).
APP_URL=http://localhost:3000

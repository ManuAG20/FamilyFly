# Copia este archivo a .env.local y completa solo lo que necesites.
# Nunca subas .env.local al repositorio.

# Proveedor de vuelos: mock | travelpayouts | ignav
# En la Fase 1 solo esta implementado "mock".
FLIGHT_PROVIDER=mock

# Horas de cache para resultados de proveedores reales (Fase 2).
FLIGHT_CACHE_TTL_HOURS=6

# Fase 2: token de Travelpayouts (solo servidor).
TRAVELPAYOUTS_TOKEN=

# Fase 2: clave de la API de Ignav (solo servidor).
IGNAV_API_KEY=

# Fase 3: Supabase. Las variables NEXT_PUBLIC_* llegan al navegador.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Fase 3: solo servidor. Nunca usar en componentes cliente.
SUPABASE_SERVICE_ROLE_KEY=

# Fase 4: alertas por Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# Fase 4: secreto compartido con GitHub Actions para ejecutar el job.
CRON_SECRET=

# Fase 4 opcional: email de alertas con Resend.
RESEND_API_KEY=

# URL publica de la app (local en desarrollo).
APP_URL=http://localhost:3000
